    family-names: "Gómez López"
    affiliation: "University of Almería"
version: "1.0.0"
date-released: "2026-08-04"
license: MIT
keywords:
  - penetration testing
  - security auditing
  - metasploit
  - large language models
  - LLM agents
  - vulnerability assessment
